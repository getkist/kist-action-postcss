{
  "name": "@getkist/action-postcss",
  "version": "1.0.23",
  "description": "PostCSS processing actions for kist",
  "main": "./dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "kist",
    "kist-action",
    "postcss",
    "css",
    "autoprefixer",
    "cssnano",
    "minify"
  ],
  "author": "kist",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getkist/kist-action-postcss.git"
  },
  "bugs": {
    "url": "https://github.com/getkist/kist-action-postcss/issues"
  },
  "homepage": "https://github.com/getkist/kist-action-postcss#readme",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=\\.test\\.ts$",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathPatterns=\\.integration\\.test\\.ts$",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "clean": "rm -rf dist docs/api coverage",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "peerDependencies": {
    "kist": ">=0.1.58"
  },
  "dependencies": {
    "postcss": "^8.5.14",
    "autoprefixer": "^10.5.0",
    "cssnano": "^8.0.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "25.8.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "10.4.0",
    "jest": "30.4.2",
    "ts-jest": "^29.4.9",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "tsup": "^8.5.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "module": "./dist/index.mjs"
}
